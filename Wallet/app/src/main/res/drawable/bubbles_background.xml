<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item >
        <shape >
            <solid android:color="#5fb671" />
            <size
                android:width="100dp"
                android:height="50dp"/>
        </shape>
    </item>

    <item android:gravity="top|end" android:top="-80dp">
        <shape >
            <solid android:color="#53ad67" />
            <corners android:radius="160dp"/>
            <size
                android:width="160dp"
                android:height="160dp"/>
        </shape>
    </item>


    <item android:gravity="bottom|start" android:bottom="-60dp">
        <shape >
            <solid android:color="#53ad67" />
            <corners android:radius="120dp"/>
            <size
                android:width="120dp"
                android:height="120dp"/>
        </shape>
    </item>
</layer-list>
