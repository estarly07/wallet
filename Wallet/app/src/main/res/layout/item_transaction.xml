<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <include layout="@layout/path_with_image" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/salary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDescriptionTransaction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Sueldo disponible"
                android:textColor="@color/black"
                android:textSize="@dimen/normal"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDateTransaction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="9:09 AM - Aug 18, 2021"
                android:textColor="@color/grayDark"
                android:textSize="@dimen/small" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtAmountTransaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="10dp"
            android:ellipsize="end"
            android:lines="1"
            android:textColor="@color/black"
            android:textSize="@dimen/subtitle"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_money" />
    </LinearLayout>
    <!--    <View-->
    <!--        android:id="@+id/separator"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="0.5dp"-->
    <!--        android:layout_marginTop="5dp"-->
    <!--        android:layout_marginBottom="20dp"-->
    <!--        android:layout_marginHorizontal="10dp"-->
    <!--        android:background="@color/grayLight"/>-->
</LinearLayout>