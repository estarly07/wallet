<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Saldo disponible"
            android:textColor="@color/grayLight"
            android:textSize="@dimen/subtitle"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/titleScreen"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_money"
                app:tint="@color/orangeDark" />

            <TextView
                android:id="@+id/txtSalary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:text="$1.000.000"
                android:textColor="@color/white"
                android:textSize="@dimen/titleScreen"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgNoVisibleSalary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:src="@drawable/ic_line"
                android:visibility="gone"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnVisibilityBalance"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:backgroundTint="@color/transparent"
                android:src="@drawable/ic_visible" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:orientation="vertical">

        <Button
            style="@style/Base.Theme.Wallet"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/grayDark"
            android:drawableStart="@drawable/ic_edit"
            android:drawableTint="@color/white"
            android:padding="0dp"
            android:text="Estadisticas"
            android:textColor="@color/white"
            android:textSize="@dimen/small" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COP"
            android:textColor="@color/white"
            android:textSize="@dimen/subtitle"
            android:textStyle="bold"
            app:drawableEndCompat="@drawable/ic_badge"
            app:drawableTint="@color/white" />
    </LinearLayout>

</LinearLayout>
