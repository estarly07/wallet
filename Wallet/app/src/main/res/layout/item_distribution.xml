<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/cornersCard"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/imgAddDistribution"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="35dp"
            android:src="@drawable/ic_add"
            app:tint="@color/grayLight" />

        <LinearLayout
            android:id="@+id/itemDistribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/imgItemDistribution"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:scaleType="centerCrop"
                app:riv_corner_radius_top_left="@dimen/cornersCard"
                app:riv_corner_radius_top_right="@dimen/cornersCard"
                android:src="@drawable/one"
                />

            <TextView
                android:id="@+id/txtTitleItemDistribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lines="1"
                android:text="Nombre de distribuccion"
                android:textColor="@color/grayDark"
                android:textSize="@dimen/normal"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="7dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtAmountItemDistribution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:drawableTint="@color/grayLight"
                    android:drawableStart="@drawable/ic_money"
                    android:lines="1"
                    android:text="$50000000"
                    android:textColor="@color/grayLight"
                    android:textSize="@dimen/subtitle" />

                <ImageView
                    android:id="@+id/btnSettingsItemDistribution"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_setting"
                    app:tint="@color/grayLight" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/imgCheckDistribution"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="35dp"
            android:visibility="gone"
            android:src="@drawable/ic_check"
            app:tint="@color/salary" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>