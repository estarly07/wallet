<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/background_corners_top_rounded"
    android:layout_gravity="bottom"
    android:backgroundTint="@color/white"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_marginTop="20dp"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/btnCloseDialog"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="20dp"
            android:background="@color/white"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnSavingMoney"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="20dp"
            android:backgroundTint="@color/percentageSpent"
            android:textSize="@dimen/normal"
            android:text="Ahorrar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:src="@drawable/saving_money_two"/>
    <TextView
        android:id="@+id/txtTitleDialogGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:text="¿Cuánto dinero deseas ahorrar?"
        android:textColor="@color/grayDark"
        android:textSize="@dimen/title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:text="¡Prepara el camino hacia tus metas financieras y agrega la cantidad que deseas a tu cofre de deseos financiero!"
        android:textColor="@color/grayLight"
        android:textSize="@dimen/normal" />
    <EditText
        android:id="@+id/edtAmount"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="25dp"
        android:background="@drawable/background_outline"
        android:backgroundTint="@color/grayLight2"
        android:layout_marginVertical="20dp"
        android:hint="$ 1.000.000"
        android:inputType="numberDecimal"
        android:textSize="@dimen/subtitle"
        android:padding="10dp"
        android:layout_height="wrap_content"/>


</LinearLayout>