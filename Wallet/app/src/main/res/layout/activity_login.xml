<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundScreens"
    android:paddingHorizontal="20dp"
    tools:context=".presentation.screens.LoginActivity">

    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="100dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:src="@drawable/authentification"/>
    <TextView
        android:id="@+id/txtTitleLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingresa tu clave"
        android:layout_marginTop="15dp"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="@dimen/titleScreen"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDescriptionLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Sabemos que eres tú, pero siempre es bueno confirmar por seguridad :)"
        android:gravity="center"
        android:textColor="@color/grayLight"
        android:textSize="@dimen/subtitle"
        android:textStyle="bold" />
    <include
        android:id="@+id/edtPasswordLogin"
        android:layout_gravity="center"
        layout="@layout/password"
        android:layout_marginVertical="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <EditText
        android:id="@+id/edtPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLength="4"
        android:visibility="gone"/>
    <include
        android:id="@+id/keyboardLogin"
        android:layout_gravity="center"
        layout="@layout/keyboard"
        android:layout_marginTop="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>