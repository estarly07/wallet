<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:layout_marginVertical="10dp"
    android:orientation="horizontal">


    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/imgItemDistribution"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="centerCrop"
        android:src="@drawable/one"
        app:riv_corner_radius="@dimen/cornersCardButton" />


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTitleItemDistribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lines="1"
            android:text="Nombre de distribuccion"
            android:textColor="@color/grayDark"
            android:textSize="@dimen/normal"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAmountItemDistribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableTint="@color/grayLight"
            android:ellipsize="end"
            android:lines="1"
            android:text="$50000000"
            android:textColor="@color/grayLight"
            android:textSize="@dimen/subtitle"
            app:drawableStartCompat="@drawable/ic_money" />

    </LinearLayout>

    <ImageView
        android:id="@+id/imgCheckDistribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_check"
        app:tint="@color/salary" />
</LinearLayout>
