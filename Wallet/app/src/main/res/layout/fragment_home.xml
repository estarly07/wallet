<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/backgroundScreens"
    tools:context=".presentation.screens.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bienvenido"
                android:textColor="@color/black"
                android:textSize="@dimen/titleScreen"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDrawerMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/backgroundScreens"
                android:src="@drawable/ic_menu"/>
        </LinearLayout>

        <include
            android:id="@+id/salaryCard"
            layout="@layout/salary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="25dp" />

        <include
            android:id="@+id/graphic"
            layout="@layout/graphic_home"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="25dp" />

        <include
            android:id="@+id/buttons_actions_transactions"
            layout="@layout/buttons_actions_transactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/txtAllTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="25dp"
            android:text="Transacciones hoy"
            android:textColor="@color/grayDark"
            android:textSize="@dimen/subtitle"
            android:textStyle="bold"
            app:drawableRightCompat="@drawable/arrow_right" />

        <include
            android:id="@+id/transactions"
            layout="@layout/transactions_today_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="15dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>